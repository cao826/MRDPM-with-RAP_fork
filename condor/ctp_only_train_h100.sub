# Train MRDPM (ctp-only, f13 Tmax or rCBF) on the H100 NVL box, one fold per job (ctp_only_plan.md
# §13 step 4, §18; recipe in ctp_only_decisions.md #11-#12). About 20 h for 200 epochs.
#
# The data are read from the H100 box's own disk, /home/colivares/mrdpm_ctp_only/stage: run
# ctp_only_stage_home.sub once per target first (ctp_only_decisions.md #17). The run folder is
# written there too, and its results go to /radraid2/colivares/mrdpm_ctp_only/runs/<experiment>/
# every 10 minutes and at the end. The code is this checkout on 14958, shipped by Condor: git pull
# before submitting.
#
#   cd condor && mkdir -p log
#   condor_submit ctp_only_train_h100.sub                              # debug: 1 epoch, 2 slices
#   condor_submit ctp_only_train_h100.sub -append 'mode = full'        # the real run, fold 0
#   condor_submit ctp_only_train_h100.sub -append 'mode = full' -append 'fold = 3'
#   condor_submit ctp_only_train_h100.sub -append 'mode = full' \
#       -append 'resume = /radraid2/colivares/mrdpm_ctp_only/runs/<experiment>/checkpoint/<epoch>'
#   condor_submit ctp_only_train_h100.sub -append 'target = rcbf'      # rCBF, debug (tmax if not given)
#
#   tail -f log/ctp_only_train_h100.<cluster>.0.out
universe                = docker
docker_image            = registry.cvib.ucla.edu/colivares:mrdpm-env-v1

executable              = ctp_only_train_h100.sh
arguments               = $(fold:0) $(mode:debug) $(Cluster).$(Process) $(resume:)
# In the environment, not the arguments: resume may be empty, and a Tmax job reads the same
# arguments it always did.
environment             = "MRDPM_TARGET=$(target:tmax)"
# No trailing slash: the checkout arrives in the workspace as MRDPM-with-RAP_fork/.
transfer_input_files    = /raid/colivares/github_repos/MRDPM-with-RAP_fork
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# Results go to /radraid2 from the script. Through Condor only this summary comes back (the script
# creates it first thing): naming it keeps Condor from sending the workspace's data back here.
transfer_output_files   = job_summary.txt
transfer_output_remaps  = "job_summary.txt = log/ctp_only_train_h100.$(cluster).$(process).summary"

requirements            = (Machine == "$(gpu_host:REDLRADADM35838).ad.medctr.ucla.edu")
# DataLoader workers hand batches over through /dev/shm.
+DevShmSize             = 8589934592

request_gpus            = 1
request_cpus            = 8
request_memory          = 32G
# Only the code, run.py's output and the job config live in the workspace; data and the run
# folder are on /home.
request_disk            = 2G

output                  = log/ctp_only_train_h100.$(cluster).$(process).out
error                   = log/ctp_only_train_h100.$(cluster).$(process).err
log                     = log/ctp_only_train_h100.$(cluster).$(process).log
stream_output           = True
stream_error            = True

queue
