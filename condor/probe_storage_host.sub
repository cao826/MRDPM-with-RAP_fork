# probe_storage.sub's questions asked on the boxes themselves, with no container (vanilla
# universe): does /home/colivares exist on the box at all, and what is mounted there? Compare with
# probe_storage.sub's docker lines: a folder seen here and not there is one Condor doesn't mount
# into docker jobs on that box (the admins' DOCKER_VOLUMES setting), not a missing folder.
#
#   cd condor && mkdir -p log && condor_submit probe_storage_host.sub
#   grep -h VERDICT log/probe_storage*.out
universe                = vanilla

executable              = probe_storage.sh
arguments               = vanilla $(host)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

requirements            = (Machine == "$(host).ad.medctr.ucla.edu")

request_cpus            = 1
request_memory          = 2G
request_disk            = 2G

output                  = log/probe_storage.vanilla.$(host).$(cluster).out
error                   = log/probe_storage.vanilla.$(host).$(cluster).err
log                     = log/probe_storage_host.$(cluster).log

queue host in (REDLRADADM35839, REDLRADADM35840, REDLRADADM14959)
