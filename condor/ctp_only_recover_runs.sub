# Copy training runs that finished on the H100 box but never reached /radraid2
# (ctp_only_decisions.md #26): Condor evicted the job and ran it again, the restarted attempt
# trained into a second run folder on the box's /home, and the job's copy step (fixed since)
# copied only the first. No GPU. It only adds folders to /radraid2/colivares/mrdpm_ctp_only/runs/,
# so it is safe beside running jobs; rerun it whenever a run looks stuck there.
#
#   cd condor && mkdir -p log && condor_submit ctp_only_recover_runs.sub
#   cat log/ctp_only_recover_runs.<cluster>.0.out      # paste this back
#
# A run counts as finished when it has checkpoint `epoch` (200 unless -append 'epoch = N').
universe                = docker
docker_image            = registry.cvib.ucla.edu/colivares:mrdpm-env-v1

executable              = ctp_only_recover_runs.sh
arguments               = $(epoch:200)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

requirements            = (Machine == "REDLRADADM35838.ad.medctr.ucla.edu")

request_cpus            = 2
request_memory          = 4G
request_disk            = 1G

output                  = log/ctp_only_recover_runs.$(cluster).$(process).out
error                   = log/ctp_only_recover_runs.$(cluster).$(process).err
log                     = log/ctp_only_recover_runs.$(cluster).$(process).log
stream_output           = True
stream_error            = True

queue
