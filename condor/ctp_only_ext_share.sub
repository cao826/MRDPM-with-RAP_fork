# How much of gan_bpm's generator gradient L_ext carries, at each trained fold model and at
# initialization (scripts/ctp_only_ext_share.py), on 14958's GPU: seconds per batch, against
# minutes on the CPU. Trains nothing and writes no checkpoint.
#
#   cd /raid/colivares/github_repos/MRDPM-with-RAP_fork && git pull
#   cd condor && mkdir -p log && condor_submit ctp_only_ext_share.sub
#   condor_submit ctp_only_ext_share.sub -append 'args = --fold 0 --no-init'      # a quick read
#   condor_submit ctp_only_ext_share.sub -append 'args = --target tmax'
#   tail -f log/ctp_only_ext_share.<cluster>.0.out
#
# It holds one GPU: count it in the account's 3.
universe                = docker
docker_image            = registry.cvib.ucla.edu/colivares:mrdpm-env-v1

executable              = ctp_only_ext_share.sh
arguments               = $(args:)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

requirements            = (Machine == "REDLRADADM14958.ad.medctr.ucla.edu")
# gan_bpm's training DataLoader workers hand batches over through /dev/shm.
+DevShmSize             = 8589934592

request_gpus            = 1
request_cpus            = 4
request_memory          = 24G
request_disk            = 1G

output                  = log/ctp_only_ext_share.$(cluster).$(process).out
error                   = log/ctp_only_ext_share.$(cluster).$(process).err
log                     = log/ctp_only_ext_share.$(cluster).$(process).log
stream_output           = True
stream_error            = True

queue
