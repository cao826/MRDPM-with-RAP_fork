# The "right place or wrong level" check (ctp_only_decisions.md #28) on 14958's GPU:
# scripts/ctp_only_core_check.py, MRDPM's CV test maps against gan_bpm's predictor on each
# fold's held-out cases. The GPU is for gan_bpm's predictions (about 60 slices/s); the rest is
# reading files, so it takes minutes per fold. First, the CV tests on the H100:
# python3 scripts/ctp_only_isles18_dag.py --testset cv --target rcbf.
#
#   cd /raid/colivares/github_repos/MRDPM-with-RAP_fork && git pull
#   cd condor && mkdir -p log && condor_submit ctp_only_core_check.sub
#   condor_submit ctp_only_core_check.sub -append 'args = --fold 0 --fold 1'       # some folds
#   tail -f log/ctp_only_core_check.<cluster>.0.out
#
# It holds one GPU: count it in the account's 3.
universe                = docker
docker_image            = registry.cvib.ucla.edu/colivares:mrdpm-env-v1

executable              = ctp_only_core_check.sh
arguments               = $(args:)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

requirements            = (Machine == "REDLRADADM14958.ad.medctr.ucla.edu")

request_gpus            = 1
request_cpus            = 4
request_memory          = 24G
request_disk            = 1G

output                  = log/ctp_only_core_check.$(cluster).$(process).out
error                   = log/ctp_only_core_check.$(cluster).$(process).err
log                     = log/ctp_only_core_check.$(cluster).$(process).log
stream_output           = True
stream_error            = True

queue
