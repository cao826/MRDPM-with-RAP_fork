# The GPU half of scripts/ctp_only_box_checks.py (ctp_only_plan.md §12): the predictor-alone
# control over the 793 held-out slices, and one forward of the Network at 512. A few minutes.
# The CPU half is a plain `docker run` on the box (no Condor).
#
#   cd condor && mkdir -p log && condor_submit ctp_only_gpu_checks.sub                          # tmax
#   cd condor && mkdir -p log && condor_submit ctp_only_gpu_checks.sub -append 'target = rcbf'
#   cat log/ctp_only_gpu_checks.<cluster>.0.out      # paste this back
universe                = docker
docker_image            = registry.cvib.ucla.edu/colivares:mrdpm-env-v1

executable              = ctp_only_gpu_checks.sh
environment             = "MRDPM_TARGET=$(target:tmax)"
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# /raid is per-machine: the checkout and the data live on 14958's. (/radraid2 is a network share.)
requirements            = (Machine == "REDLRADADM14958.ad.medctr.ucla.edu")
# DataLoader workers hand batches over through /dev/shm.
+DevShmSize             = 8589934592

# Inference only, batch 8 for the 1.9 M-parameter generator and batch 1 for the Network.
request_gpus            = 1
request_cpus            = 4
request_memory          = 16G
request_disk            = 1G

output                  = log/ctp_only_gpu_checks.$(cluster).$(process).out
error                   = log/ctp_only_gpu_checks.$(cluster).$(process).err
log                     = log/ctp_only_gpu_checks.$(cluster).$(process).log
stream_output           = True
stream_error            = True

queue
