# ctp_only_plan.md §13 step 3: the GPU smoke run. About 20 minutes.
#   1. run.py -p train -d: one epoch on 2 training slices, a monitor pass on 2, checkpoint 1.
#   2. run.py -p test -d from that checkpoint: 2 held-out slices.
#   3. scripts/ctp_only_gpu_probe.py: memory and seconds per step by batch size (§14).
# Writes under /radraid2/colivares/mrdpm_ctp_only (smoke/ and experiments/; checkpoint 1 is 1.1 GB).
#
#   cd condor && mkdir -p log && condor_submit ctp_only_smoke.sub
#   cat log/ctp_only_smoke.<cluster>.0.out      # paste this back
universe                = docker
docker_image            = registry.cvib.ucla.edu/colivares:mrdpm-env-v1

executable              = ctp_only_smoke.sh
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# /raid is per-machine: the checkout and the data live on 14958's. (/radraid2 is a network share.)
requirements            = (Machine == "REDLRADADM14958.ad.medctr.ucla.edu")
# DataLoader workers hand batches over through /dev/shm.
+DevShmSize             = 8589934592

request_gpus            = 1
request_cpus            = 4
request_memory          = 24G
request_disk            = 1G

output                  = log/ctp_only_smoke.$(cluster).$(process).out
error                   = log/ctp_only_smoke.$(cluster).$(process).err
log                     = log/ctp_only_smoke.$(cluster).$(process).log
stream_output           = True
stream_error            = True

queue
