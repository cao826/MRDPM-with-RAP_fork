# One-time, per target: copy what every fold's training and test jobs read from /radraid2 to the
# H100 box's own disk, /home/colivares/mrdpm_ctp_only/stage (ctp_only_decisions.md #17). Run it
# once per target, and again only if the data on /radraid2 change; a rerun copies only what is
# missing. No GPU.
#
#   cd condor && mkdir -p log && condor_submit ctp_only_stage_home.sub                         # tmax
#   cd condor && mkdir -p log && condor_submit ctp_only_stage_home.sub -append 'target = rcbf'
#   cat log/ctp_only_stage_home.<cluster>.0.out      # paste this back
#
# The boxes BRAN's pretraining uses (bran_ext_plan.md §2.5, decisions #37), into their own disks:
#   condor_submit ctp_only_stage_home.sub -append 'target = rcbf' -append 'gpu_host = REDLRADADM35840'  # L40S: /home/colivares
#   condor_submit ctp_only_stage_home.sub -append 'target = rcbf' -append 'gpu_host = REDLRADADM14959'  # Quadro: local /raid/colivares
# The job picks the folder from the box (<root>/stage; <root> is /raid/colivares/mrdpm_ctp_only on
# 14959, /home/colivares/mrdpm_ctp_only elsewhere). Where Tmax was never staged, rcbf copies
# gan_bpm's code itself.
#
# What it copies (about 17 GB per target): the target's index, the mask cache, and the input and
# label files of all 443 cases (scripts/ctp_only_stage_data.py --side all); split.json and
# checkpoints/best.pt of gan_bpm's 5 folds for that target; for tmax only, gan_bpm's code. It
# ends by writing STAGED_OK (tmax) or STAGED_OK_rcbf, which the training job requires. Where Tmax is
# staged, rcbf reuses its copy of gan_bpm's code and leaves Tmax's files alone, so it can run beside
# Tmax training jobs; elsewhere it copies the code itself.
universe                = docker
docker_image            = registry.cvib.ucla.edu/colivares:mrdpm-env-v1

executable              = ctp_only_stage_home.sh
environment             = "MRDPM_TARGET=$(target:tmax)"
transfer_input_files    = ../scripts/ctp_only_stage_data.py
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

requirements            = (Machine == "$(gpu_host:REDLRADADM35838).ad.medctr.ucla.edu")

# Writes to /home, not the workspace, so it needs almost no workspace disk.
request_cpus            = 2
request_memory          = 4G
request_disk            = 1G

output                  = log/ctp_only_stage_home.$(cluster).$(process).out
error                   = log/ctp_only_stage_home.$(cluster).$(process).err
log                     = log/ctp_only_stage_home.$(cluster).$(process).log
stream_output           = True
stream_error            = True

queue
